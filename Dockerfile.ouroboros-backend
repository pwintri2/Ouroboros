FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY controller/requirements.txt /tmp/wintrip-controller-requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/wintrip-controller-requirements.txt

CMD ["uvicorn", "controller.main:app", "--host", "0.0.0.0", "--port", "8010"]
