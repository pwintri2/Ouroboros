{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ouroboros Cockpit",
  "version": "0.1.0",
  "identifier": "ai.wintrip.ouroboros-cockpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ouroboros Cockpit",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8010 http://127.0.0.1:8010 http://localhost:8765 http://127.0.0.1:8765 ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:8765 ws://127.0.0.1:8765; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "headers": {
        "Permissions-Policy": "microphone=(self), camera=(self)"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "WintripAI Ouroboros command cockpit",
    "longDescription": "A local desktop shell for the WintripAI Ouroboros command cockpit. Shell execution is delegated to the Python backend sandbox endpoint.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    }
  }
}
