# Dockerfile.sandbox - Negesydd Build & Test Environment
# Purpose: Isolated Docker sandbox for building and testing Negesydd modules
# Usage: docker build -f Dockerfile.sandbox -t negesydd:dev-sandbox .

FROM python:3.11-slim

LABEL maintainer="PWintri2"
LABEL description="Negesydd development & test sandbox"
LABEL version="1.0"

WORKDIR /negesydd

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY requirements.txt .

RUN pip install --no-cache-dir \
    -r requirements.txt \
    pytest \
    pytest-asyncio \
    pytest-timeout \
    pytest-cov \
    mypy \
    pylint \
    black \
    psutil

# Create test structure
RUN mkdir -p tests && touch tests/__init__.py

# Copy source code
COPY . .

# Environment setup
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/negesydd

# Default: run pytest when container starts (unless overridden)
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]
