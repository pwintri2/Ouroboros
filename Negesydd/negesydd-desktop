#!/usr/bin/env sh
cd /home/pwintri2/Negesydd || exit 1
LOG_DIR="/home/pwintri2/Negesydd/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/negesydd-desktop.log"
{
  echo "---- $(date -Is) starting Negesydd desktop ----"
  echo "DISPLAY=${DISPLAY:-}"
  echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
  echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-}"
  echo "QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-}"
} >> "$LOG_FILE"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export QT_AUTO_SCREEN_SCALE_FACTOR=1

/home/pwintri2/Negesydd/dist/negesydd-desktop-bin/negesydd-desktop-bin >> "$LOG_FILE" 2>&1
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "Exited with status $STATUS" >> "$LOG_FILE"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error \
      --title="Negesydd could not start" \
      --text="Negesydd could not start. See:\n$LOG_FILE" \
      --width=420
  fi
fi
exit "$STATUS"
