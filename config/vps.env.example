# Copy this file to .secrets/vps.env on the host.
# Keep real SSH keys/passwords out of this file and out of the repository.

WINTRIP_VPS_PROFILE_ID=philip-wintrip-ourobouros
WINTRIP_VPS_SSH_ALIAS=wintrip-vps
WINTRIP_VPS_USER=deploy
WINTRIP_VPS_PORT=22

# Optional binary overrides on the host.
WINTRIP_SSH_BIN=ssh
WINTRIP_RSYNC_BIN=rsync
WINTRIP_SCP_BIN=scp
WINTRIP_NPM_BIN=npm

# UI build settings for the public VPS route.
WINTRIP_VPS_UI_PUBLIC_BASE=/Ouroboros/
WINTRIP_VPS_UI_BACKEND_URL=/Ouroboros

# Optional VPS-side paths for Chroma merge.
# Keep these as non-secret metadata. The default assumes the synced Ouroboros
# project lives in the public remote root below.
WINTRIP_VPS_REMOTE_WORKSPACE=/var/www/philip-wintrip.nl/html/Ouroboros
WINTRIP_VPS_REMOTE_CHROMA_PATH=/var/www/philip-wintrip.nl/html/Ouroboros/wintrip_brain
# If the VPS uses a Chroma HTTP server reachable from the VPS itself, prefer
# this over the path above, for example http://127.0.0.1:18000.
WINTRIP_VPS_REMOTE_CHROMA_HTTP_URL=
WINTRIP_CHROMA_SYNC_COLLECTIONS=wintrip_knowledge,wintrip_training_11d,wintrip_world_understanding,wintrip_ooda_dreamcycle_11d,wintrip_trigger_actions_11d,wintrip_agentic_sessions_11d
