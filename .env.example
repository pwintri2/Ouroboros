# WintripAI runtime configuration

# Canonical project root inside Docker / sandbox-aware flows
WINTRIP_PROJECT_ROOT=/app
WINTRIP_DATA_DIR=/app/data
WINTRIP_OUTPUT_DIR=/app/output
WINTRIP_MULTI_AGENT_ENABLED=1

# Main orchestration: Hoofdagent runs via Gemini CLI
WINTRIP_ORCHESTRATOR_PROVIDER=gemini
WINTRIP_ORCHESTRATOR_MODEL=gemini-2.5-pro
WINTRIP_OPENAI_CLI=codex

# Default execution provider/model for sub-agents
WINTRIP_SUBAGENT_PROVIDER=ollama
WINTRIP_SUBAGENT_MODEL=gemma4:latest

# Per-agent defaults
WINTRIP_AGENT1_PROVIDER=ollama
WINTRIP_AGENT1_MODEL=gemma4:latest
WINTRIP_AGENT2_PROVIDER=ollama
WINTRIP_AGENT2_MODEL=gemma4:latest
WINTRIP_AGENT3_PROVIDER=ollama
WINTRIP_AGENT3_MODEL=gemma4:latest
WINTRIP_AGENT4_PROVIDER=ollama
WINTRIP_AGENT4_MODEL=gemma4:latest

# Optional external tool hooks
WINTRIP_GEMINI_CLI=gemini
WINTRIP_ANTIGRAVITY_CMD=
WINTRIP_ANTIGRAVITY_API_URL=

# Ollama defaults
OLLAMA_MODEL=gemma4:latest
OLLAMA_HOST=http://localhost:11434
