# Ouroboros sandbox allow environment.
#
# Purpose:
#   Runtime flags for the local Docker sandbox when Philip has given broad
#   Akkoord for this experiment.
# Inputs:
#   No secrets. Token paths, if used, still point to local files under
#   /workspace/.secrets and must be mounted/provided separately.
# Outputs:
#   Enables live adapter attempts when an endpoint/action also carries Akkoord,
#   and makes Gemma4 the local guard/distillation model.
# Safety notes:
#   This file intentionally contains no API keys or OAuth tokens. It does not
#   disable redaction, untrusted-data handling or audit output.
# Akkoord requirements:
#   Philip supplied broad sandbox approval on 2026-05-02; endpoints that still
#   ask for an approval field should receive "Akkoord".
#
# Why this change:
#   The deep ecosystem Docker run needs explicit allow flags passed into the
#   backend process without hiding the safety state in code.

WINTRIP_SANDBOX_PREAPPROVED=1
WINTRIP_DEFAULT_APPROVAL=Akkoord
WINTRIP_APPROVAL_PHRASE=Akkoord

WINTRIP_ALLOW_LIVE_GOOGLE_API=1
WINTRIP_ALLOW_LIVE_MICROSOFT_GRAPH=1
WINTRIP_ALLOW_AGENTIC_CRAWLER=1
WINTRIP_ALLOW_POPOS_DIAGNOSTICS=1
WINTRIP_ALLOW_ECOSYSTEM_INGEST=1
WINTRIP_SELF_CONTEXT_ENABLED=1

WINTRIP_RUFLO_PATH=/home/pwintri2/ruflo
WINTRIP_CODEX_PATH=/codex
WINTRIP_ROO_PATH=/home/pwintri2/Roo
WINTRIP_AGENTS_PATH=/agents
WINTRIP_OPENHANDS_PATH=/openhands
WINTRIP_CODEX_BINARY=/codex_native/bin/linux-x86_64/codex
CODEX_BINARY=/codex_native/bin/linux-x86_64/codex
WINTRIP_CODEX_TIMEOUT_SECONDS=1800

WINTRIP_GUARD_MODEL=gemma4:latest
WINTRIP_GEMMA_GUARD_MODEL=gemma4:latest
WINTRIP_KNOWLEDGE_MODEL=gemma4:latest
WINTRIP_KNOWLEDGE_GUARD_MODEL=gemma4:latest
OLLAMA_MODEL=gemma4:latest

WINTRIP_GEMMA_DISTILL_TOKENS=520
WINTRIP_GEMMA_DISTILL_TIMEOUT=120
WINTRIP_MINI_ROUTER_GEMMA=0
WINTRIP_MINI_ROUTER_GEMMA_MODEL=gemma4:latest
WINTRIP_MINI_ROUTER_GEMMA_TIMEOUT=3
WINTRIP_MINI_ROUTER_GEMMA_COOLDOWN_SECONDS=10
WINTRIP_MINI_ROUTER_GEMMA_HOST_SENSORY=0
WINTRIP_MINI_ROUTER_HOST_FLOW_LIMIT=3
WINTRIP_QIF_THRESHOLD=0.85
WINTRIP_QIF_PHASE_GAIN=0.65
WINTRIP_QIF_GPU=auto
WINTRIP_QIF_GPU_VRAM_MB=4096
WINTRIP_QIF_GPU_MEMORY_FRACTION=0.5
WINTRIP_QIF_GPU_DTYPE=complex64
WINTRIP_KNOWLEDGE_LIST_PATH=/workspace/artifacts/OUROBOROS_KENNIS_LIJST.md
